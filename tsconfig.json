{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "shared/**/*.ts",
    "lib/output-window.js",
    "lib/output-control.js",
    "lib/watch-stream.js"
  ]
}
