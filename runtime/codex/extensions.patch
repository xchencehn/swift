+use std::collections::BTreeMap;
+
 #[derive(Debug, Clone, PartialEq, Eq)]
 pub(crate) enum StatusAccountDisplay {
     ChatGpt {
@@ -6,3 +8,81 @@ pub(crate) enum StatusAccountDisplay {
     },
     ApiKey,
 }
+
+impl StatusAccountDisplay {
+    /// Resolve a short label from the connected server's account identity.
+    pub(crate) fn short_name(&self, aliases: &BTreeMap<String, String>) -> Option<String> {
+        let email = match self {
+            Self::ApiKey => return Some("api".to_string()),
+            Self::ChatGpt { email, .. } => email.as_deref()?.trim(),
+        };
+        let alias = aliases
+            .iter()
+            .find(|(address, _)| address.eq_ignore_ascii_case(email))
+            .map(|(_, alias)| alias.as_str());
+        alias.and_then(short_label).or_else(|| {
+            let local_part = email.split_once('@')?.0;
+            short_label(local_part)
+        })
+    }
+}
+
+fn short_label(value: &str) -> Option<String> {
+    let label: String = value
+        .chars()
+        .filter(|c| c.is_alphanumeric() || matches!(c, '-' | '_' | '.'))
+        .take(12)
+        .collect();
+    (!label.is_empty()).then_some(label)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    fn account(email: Option<&str>) -> StatusAccountDisplay {
+        StatusAccountDisplay::ChatGpt {
+            email: email.map(str::to_string),
+            plan: None,
+        }
+    }
+
+    #[test]
+    fn account_short_name_uses_case_insensitive_aliases() {
+        let aliases = BTreeMap::from([("alice@example.com".into(), "al".into())]);
+        assert_eq!(
+            account(Some("Alice@Example.com")).short_name(&aliases),
+            Some("al".into())
+        );
+        assert_eq!(
+            account(Some("bob@example.com")).short_name(&aliases),
+            Some("bob".into())
+        );
+    }
+
+    #[test]
+    fn account_short_name_handles_missing_identity_and_api_keys() {
+        let aliases = BTreeMap::new();
+        for email in [None, Some(""), Some("@example.com"), Some("unknown")] {
+            assert_eq!(account(email).short_name(&aliases), None);
+        }
+        assert_eq!(
+            StatusAccountDisplay::ApiKey.short_name(&aliases),
+            Some("api".into())
+        );
+    }
+
+    #[test]
+    fn account_short_name_keeps_labels_short_and_single_line() {
+        let aliases = BTreeMap::from([("alice@example.com".into(), "\n\u{1b}al\r".into())]);
+        assert_eq!(
+            account(Some("alice@example.com")).short_name(&aliases),
+            Some("al".into())
+        );
+        assert_eq!(
+            account(Some("averylongaccountname@example.com")).short_name(&aliases),
+            Some("averylongacc".into())
+        );
+    }
+}
