+#[tokio::test]
+async fn slash_hfork_without_thread_never_submits_model_work() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = None;
+    chat.dispatch_command(SlashCommand::Hfork);
+    assert!(op_rx.try_recv().is_err());
+    let cells = drain_insert_history_transcript(&mut rx);
+    let rendered = cells
+        .iter()
+        .map(|lines| lines_to_single_string(lines))
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(rendered.contains("try /hfork again"));
+}
+
