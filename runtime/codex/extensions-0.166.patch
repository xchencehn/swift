index 0000000..8a9e176
--- /dev/null
+++ b/codex-rs/tui/src/swift_side.rs
@@ -0,0 +1,237 @@
+//! Same-process side thread access for Swift. No PTY input or second agent.
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use codex_app_server_client::{AppServerRequestHandle, TypedRequestError};
+use codex_app_server_protocol::{
+    ClientRequest, RequestId, ThreadForkParams, ThreadForkResponse, ThreadLoadedListParams,
+    ThreadLoadedListResponse, ThreadReadParams, ThreadReadResponse, ThreadUnsubscribeParams,
+    ThreadUnsubscribeResponse, TurnInterruptParams, TurnInterruptResponse,
+};
+use codex_protocol::ThreadId;
+use serde_json::{Value, json};
+use std::sync::{Arc, Mutex, OnceLock};
+use std::time::Duration;
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+#[cfg(unix)]
+struct SocketGuard(String);
+#[cfg(unix)]
+impl Drop for SocketGuard {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.0);
+    }
+}
+static SENDER: OnceLock<Mutex<AppEventSender>> = OnceLock::new();
+
+pub(crate) fn start(sender: AppEventSender) {
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if std::env::var("HERDR_ENV").as_deref() != Ok("1") {
+            return;
+        }
+        if let Some(current) = SENDER.get() {
+            *current.lock().unwrap() = sender;
+            return;
+        }
+        let Ok(stat) = std::fs::read_to_string("/proc/self/stat") else {
+            return;
+        };
+        let Some(start) = stat
+            .rsplit_once(") ")
+            .and_then(|(_, rest)| rest.split_whitespace().nth(19))
+        else {
+            return;
+        };
+        let path = format!("/tmp/swift-codex-{}-{start}.sock", std::process::id());
+        let Ok(listener) = tokio::net::UnixListener::bind(&path) else {
+            return;
+        };
+        if std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600)).is_err() {
+            let _ = std::fs::remove_file(path);
+            return;
+        }
+        let _ = SENDER.set(Mutex::new(sender));
+        let guard = SocketGuard(path);
+        tokio::spawn(async move {
+            let _guard = guard;
+            // Bounded independent consumers keep a fork from blocking state/input.
+            let permits = Arc::new(tokio::sync::Semaphore::new(4));
+            loop {
+                let Ok((stream, _)) = listener.accept().await else {
+                    break;
+                };
+                let Ok(permit) = Arc::clone(&permits).try_acquire_owned() else {
+                    continue;
+                };
+                tokio::spawn(async move {
+                    let _permit = permit;
+                    let (read, mut write) = stream.into_split();
+                    let mut line = String::new();
+                    let mut read = BufReader::new(tokio::io::AsyncReadExt::take(read, 1049601));
+                    let request =
+                        tokio::time::timeout(Duration::from_secs(3), read.read_line(&mut line))
+                            .await;
+                    if !matches!(request, Ok(Ok(1..))) || line.len() > 1049600 {
+                        return;
+                    }
+                    let Ok(request) = serde_json::from_str::<Value>(&line) else {
+                        return;
+                    };
+                    let (reply, result) = tokio::sync::oneshot::channel();
+                    if let Some(sender) = SENDER.get() {
+                        sender
+                            .lock()
+                            .unwrap()
+                            .send(AppEvent::SwiftSideRequest { request, reply });
+                    }
+                    let value = match tokio::time::timeout(Duration::from_secs(30), result).await {
+                        Ok(Ok(value)) => value,
+                        _ => json!({"error":"Native side operation result is unconfirmed"}),
+                    };
+                    if let Ok(mut data) = serde_json::to_vec(&value) {
+                        data.push(b'\n');
+                        let _ =
+                            tokio::time::timeout(Duration::from_secs(3), write.write_all(&data))
+                                .await;
+                    }
+                });
+            }
+        });
+    }
+}
+
+pub(crate) fn handle(
+    request: Value,
+    reply: tokio::sync::oneshot::Sender<Value>,
+    main: Option<ThreadId>,
+    side: Option<ThreadId>,
+    active: Option<ThreadId>,
+    turn_id: Option<String>,
+    handle: AppServerRequestHandle,
+    request_id: RequestId,
+) {
+    let main_id = main.map(|id| id.to_string());
+    let side_id = side.map(|id| id.to_string());
+    let active_id = active.map(|id| id.to_string());
+    let operation = request["operation"].as_str().unwrap_or("").to_string();
+    if operation == "identity" {
+        let _ = reply.send(
+            json!({"version":1,"mainId":main_id,"sideId":side_id,"activeId":active_id,"data":{}}),
+        );
+        return;
+    }
+    if main_id.as_deref() != request["mainId"].as_str() {
+        let _ = reply.send(json!({"error":"Main thread changed"}));
+        return;
+    }
+    if operation != "read"
+        && operation != "state"
+        && operation != "fork"
+        && operation != "interrupt"
+    {
+        let _ = reply.send(json!({"error":"Unsupported side operation"}));
+        return;
+    }
+    if (operation == "fork" || operation == "interrupt")
+        && (side_id.is_none() || side_id.as_deref() != request["sideId"].as_str())
+    {
+        let _ = reply.send(json!({"error":"Side thread changed"}));
+        return;
+    }
+    tokio::spawn(async move {
+        let result = if operation == "interrupt" {
+            let expected = request["turnId"].as_str().unwrap_or("");
+            if active_id != side_id || expected.is_empty() || turn_id.as_deref() != Some(expected) {
+                Ok(json!({"interrupted":false}))
+            } else {
+                handle
+                    .request_typed::<TurnInterruptResponse>(ClientRequest::TurnInterrupt {
+                        request_id,
+                        params: TurnInterruptParams {
+                            thread_id: side_id.clone().unwrap(),
+                            turn_id: expected.to_string(),
+                        },
+                    })
+                    .await
+                    .map(|_| json!({"interrupted":true}))
+            }
+        } else if operation == "fork" {
+            let source = handle
+                .request_typed::<ThreadReadResponse>(ClientRequest::ThreadRead {
+                    request_id,
+                    params: ThreadReadParams {
+                        thread_id: side_id.clone().unwrap(),
+                        include_turns: false,
+                    },
+                })
+                .await;
+            match source {
+                Err(error) => Err(error),
+                Ok(source) => {
+                    let mut config = std::collections::HashMap::new();
+                    config.insert("thread_unload_delay_secs".to_string(), json!(0));
+                    if let Some(effort) = source.thread.reasoning_effort {
+                        config.insert(
+                            "model_reasoning_effort".to_string(),
+                            serde_json::to_value(effort).unwrap(),
+                        );
+                    }
+                    async {
+                        let fork = handle.request_typed::<ThreadForkResponse>(ClientRequest::ThreadFork {
+                            request_id: RequestId::String(format!("swift-side-fork-{}", uuid::Uuid::new_v4())),
+                            params: ThreadForkParams {
+                                thread_id: side_id.clone().unwrap(), model: source.thread.model,
+                                model_provider: Some(source.thread.model_provider), config: Some(config),
+                                exclude_turns: true, thread_source: Some(codex_app_server_protocol::ThreadSource::User), defer_goal_continuation: true, ..Default::default()
+                            },
+                        }).await?;
+                        // The new Tab needs its own writer. The creating TUI must
+                        // release only this newly created, idle persistent fork.
+                        handle.request_typed::<ThreadUnsubscribeResponse>(ClientRequest::ThreadUnsubscribe {
+                            request_id: RequestId::String(format!("swift-side-detach-{}", uuid::Uuid::new_v4())),
+                            params: ThreadUnsubscribeParams { thread_id: fork.thread.id.clone() },
+                        }).await?;
+                        let deadline = tokio::time::Instant::now() + Duration::from_secs(20);
+                        while tokio::time::Instant::now() < deadline {
+                            let loaded = handle.request_typed::<ThreadLoadedListResponse>(ClientRequest::ThreadLoadedList {
+                                request_id: RequestId::String(format!("swift-side-detached-{}", uuid::Uuid::new_v4())),
+                                params: ThreadLoadedListParams::default(),
+                            }).await?;
+                            // Native removal happens after shutdown_and_wait,
+                            // including the persistent writer's flush and close.
+                            if !loaded.data.contains(&fork.thread.id) {
+                                return Ok(json!({"sessionId":fork.thread.id,"model":fork.model,
+                                    "modelProvider":fork.model_provider,"reasoningEffort":fork.reasoning_effort}));
+                            }
+                            tokio::time::sleep(Duration::from_millis(50)).await;
+                        }
+                        Err(TypedRequestError::Transport { method: "thread/unsubscribe".to_string(),
+                            source: std::io::Error::new(std::io::ErrorKind::TimedOut, "New fork writer release is unconfirmed") })
+                    }.await
+                }
+            }
+        } else if operation == "read"
+            && let Some(side_id) = side_id.as_ref()
+        {
+            handle
+                .request_typed::<ThreadReadResponse>(ClientRequest::ThreadRead {
+                    request_id,
+                    params: ThreadReadParams {
+                        thread_id: side_id.clone(),
+                        include_turns: true,
+                    },
+                })
+                .await
+                .map(|result| json!({"thread":result.thread}))
+        } else {
+            Ok(json!({}))
+        };
+        let result = match result {
+            Ok(data) => {
+                json!({"version":1,"mainId":main_id,"sideId":side_id,"activeId":active_id,"turnId":turn_id,"data":data})
+            }
+            Err(error) => json!({"error":error.to_string()}),
+        };
+        let _ = reply.send(result);
+    });
+}
