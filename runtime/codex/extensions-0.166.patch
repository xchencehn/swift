diff --git a/codex-rs/tui/src/herdr_fork.rs b/codex-rs/tui/src/herdr_fork.rs
new file mode 100644
index 0000000..6bf09ba
--- /dev/null
+++ b/codex-rs/tui/src/herdr_fork.rs
@@ -0,0 +1,223 @@
+//! Local Herdr integration. This path never submits a user turn or a model request.
+
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use crate::history_cell;
+use codex_protocol::ThreadId;
+use serde::Deserialize;
+use std::process::Stdio;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+use tokio::process::Command;
+
+static RUNNING: AtomicBool = AtomicBool::new(false);
+
+struct RunningGuard;
+
+impl Drop for RunningGuard {
+    fn drop(&mut self) {
+        RUNNING.store(false, Ordering::Release);
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct ForkResult {
+    source_session: String,
+    new_pane: String,
+    new_session: String,
+    command_sent: bool,
+}
+
+pub(crate) fn start(thread_id: ThreadId, tx: AppEventSender) -> Result<(), String> {
+    if std::env::var("HERDR_ENV").as_deref() != Ok("1") {
+        return Err("/hfork requires a local Codex session inside Herdr.".to_string());
+    }
+    let pane = std::env::var("HERDR_PANE_ID")
+        .ok()
+        .filter(|pane| !pane.is_empty())
+        .ok_or_else(|| "Herdr did not provide the current pane ID.".to_string())?;
+    if RUNNING
+        .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+        .is_err()
+    {
+        return Err("A Herdr fork is already in progress.".to_string());
+    }
+    let guard = RunningGuard;
+    tokio::spawn(async move {
+        let _guard = guard;
+        let herdr = std::env::var("HERDR_BIN_PATH").unwrap_or_else(|_| "herdr".to_string());
+        let result = run("herdr-codex-fork-right", &herdr, &pane, thread_id).await;
+        let cell = match result {
+            Ok(fork) => history_cell::new_info_event(
+                format!(
+                    "Fork started in right pane {} (session {}). Original pane and focus preserved.",
+                    fork.new_pane, fork.new_session
+                ),
+                None,
+            ),
+            Err(message) => history_cell::new_error_event(message),
+        };
+        tx.send(AppEvent::InsertHistoryCell(Box::new(cell)));
+    });
+    Ok(())
+}
+
+async fn run(
+    helper: &str,
+    herdr: &str,
+    pane: &str,
+    thread_id: ThreadId,
+) -> Result<ForkResult, String> {
+    // SessionStart hooks may be deferred until the first turn. The TUI already
+    // knows its exact thread, so publish it without starting a model turn.
+    let sequence = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|error| error.to_string())?
+        .as_nanos()
+        .to_string();
+    let report = tokio::time::timeout(
+        Duration::from_secs(15),
+        Command::new(herdr)
+            .args([
+                "pane",
+                "report-agent-session",
+                pane,
+                "--source",
+                "herdr:codex",
+                "--agent",
+                "codex",
+                "--agent-session-id",
+                &thread_id.to_string(),
+                "--seq",
+                &sequence,
+            ])
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .kill_on_drop(true)
+            .status(),
+    )
+    .await
+    .map_err(|_| {
+        "Reporting the current session to Herdr timed out; no fork was started.".to_string()
+    })?
+    .map_err(|error| format!("Could not report the current session to Herdr: {error}"))?;
+    if !report.success() {
+        return Err(
+            "Could not report the current session to Herdr; no fork was started.".to_string(),
+        );
+    }
+    let mut command = Command::new(helper);
+    command
+        .args([
+            "--pane",
+            pane,
+            "--expected-session-id",
+            &thread_id.to_string(),
+        ])
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .kill_on_drop(true);
+    let output = tokio::time::timeout(Duration::from_secs(150), command.output())
+        .await
+        .map_err(|_| "Herdr fork timed out. Check the pane layout before retrying.".to_string())?
+        .map_err(|error| format!("Could not run herdr-codex-fork-right: {error}"))?;
+    if !output.status.success() {
+        let message = String::from_utf8_lossy(&output.stderr).trim().to_string();
+        return Err(if message.is_empty() {
+            "Herdr fork failed; check the pane layout before retrying.".to_string()
+        } else {
+            message
+        });
+    }
+    let result: ForkResult = serde_json::from_slice(&output.stdout).map_err(|_| {
+        "Herdr fork returned an invalid response. Check the pane layout before retrying."
+            .to_string()
+    })?;
+    if !result.command_sent
+        || result.source_session != thread_id.to_string()
+        || result.new_session == result.source_session
+        || result.new_pane.is_empty()
+    {
+        return Err(
+            "Herdr fork did not confirm a new session. Check the pane layout before retrying."
+                .to_string(),
+        );
+    }
+    Ok(result)
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+
+    fn fake_herdr(dir: &std::path::Path, parent: ThreadId) -> std::path::PathBuf {
+        let herdr = dir.join("herdr");
+        std::fs::write(&herdr, format!(
+            "#!/bin/sh\n[ \"$1\" = pane ] && [ \"$2\" = report-agent-session ] && [ \"$3\" = test:p1 ] && [ \"$5\" = herdr:codex ] && [ \"$9\" = {parent} ]\n"
+        )).unwrap();
+        std::fs::set_permissions(&herdr, std::fs::Permissions::from_mode(0o755)).unwrap();
+        herdr
+    }
+
+    #[tokio::test]
+    async fn hfork_runs_only_the_local_helper_with_the_exact_session() {
+        let dir = tempfile::tempdir().unwrap();
+        let helper = dir.path().join("helper");
+        let parent = ThreadId::new();
+        let child = ThreadId::new();
+        std::fs::write(&helper, format!(
+            "#!/bin/sh\n[ \"$1\" = --pane ] && [ \"$2\" = test:p1 ] && [ \"$3\" = --expected-session-id ] && [ \"$4\" = {parent} ] || exit 1\nprintf '%s\\n' '{{\"sourceSession\":\"{parent}\",\"newPane\":\"test:p2\",\"newSession\":\"{child}\",\"commandSent\":true}}'\n"
+        )).unwrap();
+        std::fs::set_permissions(&helper, std::fs::Permissions::from_mode(0o755)).unwrap();
+        let herdr = fake_herdr(dir.path(), parent);
+        let result = run(
+            helper.to_str().unwrap(),
+            herdr.to_str().unwrap(),
+            "test:p1",
+            parent,
+        )
+        .await
+        .unwrap();
+        assert_eq!(result.new_session, child.to_string());
+        assert_eq!(result.new_pane, "test:p2");
+    }
+
+    #[tokio::test]
+    async fn hfork_never_forks_if_session_reporting_fails() {
+        let dir = tempfile::tempdir().unwrap();
+        let parent = ThreadId::new();
+        let herdr = fake_herdr(dir.path(), ThreadId::new());
+        let result = run(
+            "helper-must-not-run",
+            herdr.to_str().unwrap(),
+            "test:p1",
+            parent,
+        )
+        .await;
+        assert!(matches!(result, Err(message) if message.contains("no fork was started")));
+    }
+
+    #[tokio::test]
+    async fn hfork_reports_helper_failure_without_retrying() {
+        let dir = tempfile::tempdir().unwrap();
+        let helper = dir.path().join("helper");
+        std::fs::write(
+            &helper,
+            "#!/bin/sh\nprintf 'source session changed' >&2\nexit 1\n",
+        )
+        .unwrap();
+        std::fs::set_permissions(&helper, std::fs::Permissions::from_mode(0o755)).unwrap();
+        let parent = ThreadId::new();
+        let herdr = fake_herdr(dir.path(), parent);
+        assert!(
+            matches!(run(helper.to_str().unwrap(), herdr.to_str().unwrap(), "test:p1", parent).await, Err(message) if message == "source session changed")
+        );
+    }
+}
