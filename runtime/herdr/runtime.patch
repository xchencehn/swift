+fn direct_control_readiness_does_not_require_a_rendered_frame() {
+    with_terminal_session_test_server(|server, _, terminal_id, _| {
+        let (writer, control, rendered) = test_client_writer();
+        server.handle_server_event(ServerEvent::ClientConnected {
+            client_id: 1,
+            cols: 100,
+            rows: 30,
+            cell_width_px: 0,
+            cell_height_px: 0,
+            pixel_mouse: false,
+            writer,
+        });
+        assert!(
+            !server.handle_server_event(ServerEvent::ClientTerminalFrames {
+                client_id: 1,
+                enabled: false
+            })
+        );
+        assert!(
+            server.handle_server_event(ServerEvent::ClientControlTerminal {
+                client_id: 1,
+                target: terminal_id.clone(),
+                takeover: false,
+            })
+        );
+        let ready = read_server_message(control.recv_timeout(Duration::from_secs(1)).unwrap());
+        let ServerMessage::EndpointControl { kind, data } = ready else {
+            panic!("expected control readiness");
+        };
+        assert_eq!(kind, "terminal.control.ready");
+        assert_eq!(
+            serde_json::from_str::<serde_json::Value>(&data).unwrap(),
+            serde_json::json!({"terminal_id":terminal_id,"cols":100,"rows":30})
