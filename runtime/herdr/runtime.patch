+    /// Keep logical row positions stable when old scrollback pages are pruned.
+    /// One terminal-owned tracked cell is shared by all observers. Reflow and
+    /// discarded anchors start a new epoch rather than guessing row alignment.
+    pub fn observation_history_coordinates(&mut self) -> Result<HistoryCoordinates, Error> {
+        let geometry = (self.cols()?, self.rows()?, self.active_screen()?);
+        let first = self.total_rows()?.saturating_sub(usize::from(geometry.1));
+        let mut point = ffi::GhosttyPointCoordinate::default();
+        // SAFETY: all calls run under the owning terminal's core lock; the pin
+        // is freed before the terminal and never accessed by another owner.
+        let resolved = unsafe {
+            ffi::ghostty_tracked_grid_ref_point(
+                self.observation_anchor,
+                ffi::GhosttyPointTag_GHOSTTY_POINT_TAG_SCREEN,
+                &mut point,
+            )
+        } == ffi::GhosttyResult_GHOSTTY_SUCCESS;
+        let offset = resolved
+            .then(|| {
+                self.observation_coordinates
+                    .offset
+                    .checked_add(self.observation_first)?
+                    .checked_sub(point.y as usize)
+            })
+            .flatten();
+        match offset.filter(|_| self.observation_geometry == Some(geometry)) {
+            Some(offset) => self.observation_coordinates.offset = offset,
+            None => {
+                self.observation_coordinates.epoch += 1;
+                self.observation_coordinates.offset = 0;
+            }
+        }
+        self.observation_geometry = Some(geometry);
+        self.observation_first = first;
+        unsafe {
+            ffi::ghostty_tracked_grid_ref_free(self.observation_anchor);
+            self.observation_anchor = ptr::null_mut();
+            ffi::ghostty_terminal_grid_ref_track(
+                self.raw,
+                ffi::GhosttyPoint {
+                    tag: ffi::GhosttyPointTag_GHOSTTY_POINT_TAG_ACTIVE,
+                    value: ffi::GhosttyPointValue {
+                        coordinate: ffi::GhosttyPointCoordinate { x: 0, y: 0 },
+                    },
+                },
+                &mut self.observation_anchor,
+            )
+            .into_result()?;
+        }
+        Ok(self.observation_coordinates)
+    }
