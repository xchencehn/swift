diff --git a/src/api/terminal_stream.rs b/src/api/terminal_stream.rs
new file mode 100644
index 0000000..3dfe329
--- /dev/null
+++ b/src/api/terminal_stream.rs
@@ -0,0 +1,124 @@
+//! Connection-scoped, versioned terminal state API. A blocked socket cannot
+//! hold the terminal lock or accumulate an unbounded output queue.
+use crate::api::schema::{Method, Request};
+use crate::api::{ApiRequestMessage, ApiRequestSender};
+use crate::ipc::{local_stream_peer_closed, LocalStream};
+use crate::terminal::observation::TerminalSnapshot;
+use std::io::{self, Write};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    mpsc, Arc,
+};
+use std::time::{Duration, Instant};
+
+fn write(stream: &mut LocalStream, value: &impl serde::Serialize) -> io::Result<()> {
+    // Serializing directly to a socket would issue a write for every JSON
+    // token/cell. Bound the staging buffer without introducing a frame queue.
+    let mut writer = io::BufWriter::with_capacity(64 * 1024, stream);
+    serde_json::to_writer(&mut writer, value)?;
+    writer.write_all(b"\n")?;
+    writer.flush()
+}
+
+pub(super) fn serve(
+    mut stream: LocalStream,
+    request: Request,
+    api: &ApiRequestSender,
+    running: &Arc<AtomicBool>,
+) -> io::Result<()> {
+    let id = request.id.clone();
+    let history = match &request.method {
+        Method::TerminalHistoryRead(params) => Some(params.clone()),
+        _ => None,
+    };
+    let (reply, observation) = mpsc::sync_channel(1);
+    let (respond_to, _unused) = mpsc::channel();
+    api.send(ApiRequestMessage {
+        request,
+        respond_to,
+        response_write_complete: None,
+        terminal_observer: Some(reply),
+    })
+    .map_err(|_| io::Error::other("runtime unavailable"))?;
+    let observer = match observation.recv_timeout(Duration::from_secs(5)) {
+        Ok(Ok(observer)) => observer,
+        error => {
+            return write(
+                &mut stream,
+                &serde_json::json!({"id":id, "error":{
+                "code":"terminal_unavailable", "message":match error {
+                    Ok(Err(message)) => message, _ => "runtime unavailable".to_string()
+                }}}),
+            )
+        }
+    };
+    if let Some(params) = history {
+        let result = match observer.history(
+            &params.boot_id,
+            params.revision,
+            params.history_epoch,
+            params.start,
+            params.limit,
+        ) {
+            Ok(rows) => serde_json::json!({"id":id,"result":{"type":"terminal_history","version":1,
+                "terminal_id":observer.terminal_id,"boot_id":observer.boot_id,"revision":params.revision,"history_epoch":params.history_epoch,"start":params.start,"content":rows}}),
+            Err(message) => {
+                serde_json::json!({"id":id,"error":{"code":"history_unavailable","message":message}})
+            }
+        };
+        return write(&mut stream, &result);
+    }
+    let mut previous: Option<Arc<TerminalSnapshot>> = None;
+    let mut last_sent = None::<Instant>;
+    while running.load(Ordering::Relaxed)
+        && !observer.closed()
+        && !local_stream_peer_closed(&mut stream)?
+    {
+        // Capture the wake generation before reading to avoid losing PTY output
+        // arriving between the snapshot and the condition-variable wait.
+        let generation = observer.generation();
+        if let Some(sent) = last_sent {
+            let remaining = Duration::from_millis(8).saturating_sub(sent.elapsed());
+            if !remaining.is_zero() {
+                std::thread::sleep(remaining);
+            }
+        }
+        let snapshot = observer.snapshot().map_err(io::Error::other)?;
+        if let Some(snapshot) = snapshot.filter(|next| {
+            previous
+                .as_ref()
+                .is_none_or(|old| old.revision != next.revision)
+        }) {
+            let reset = previous.as_ref().is_none_or(|old| {
+                old.cols != snapshot.cols
+                    || old.rows != snapshot.rows
+                    || old.alternate_screen != snapshot.alternate_screen
+            });
+            let changes: Vec<_> = snapshot
+                .content
+                .iter()
+                .enumerate()
+                .filter(|(row, cells)| {
+                    reset || previous.as_ref().and_then(|old| old.content.get(*row)) != Some(*cells)
+                })
+                .collect();
+            write(
+                &mut stream,
+                &serde_json::json!({"id":id,"result":{
+                    "type":"terminal_state","version":1,"terminal_id":observer.terminal_id,"boot_id":observer.boot_id,
+                    "revision":snapshot.revision,"base_revision":if reset {None} else {previous.as_ref().map(|s| s.revision)},
+                    "cols":snapshot.cols,"rows":snapshot.rows,"total_rows":snapshot.total_rows,"first_row":snapshot.first_row,
+                    "row_offset":snapshot.row_offset,"history_epoch":snapshot.history_epoch,
+                    "history_start":snapshot.history_start,"history":snapshot.history,
+                    "cursor":snapshot.cursor,"cursor_shape":snapshot.cursor_shape,"alternate_screen":snapshot.alternate_screen,
+                    "mouse_tracking":snapshot.mouse_tracking,"mouse_sgr":snapshot.mouse_sgr,"mouse_pixels":snapshot.mouse_pixels,
+                    "bracketed_paste":snapshot.bracketed_paste,"changes":changes
+                }}),
+            )?;
+            previous = Some(snapshot);
+            last_sent = Some(Instant::now());
+        }
+        observer.wait(generation, Duration::from_millis(250));
+    }
+    Ok(())
+}
