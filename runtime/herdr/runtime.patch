+#[cfg(unix)]
+fn apply_terminal_identities(
+    manifest: &mut HandoffManifest,
+    socket_path: &Path,
+    identities: TerminalIdentityMap,
+) -> io::Result<()> {
+    let mismatch = || io::Error::other("handoff terminal identity map does not match source");
+    if identities.version != 1
+        || identities.source_version != manifest.source_version
+        || identities.source_protocol != manifest.source_protocol
+        || identities.source_socket.parent() != socket_path.parent()
+        || socket_path.file_name().and_then(|name| name.to_str())
+            != Some(format!("herdr-handoff-{}.sock", identities.source_pid).as_str())
+        || identities.terminals.len() != manifest.panes.len()
+    {
+        return Err(mismatch());
+    }
+    let by_pid: std::collections::HashMap<_, _> = identities
+        .terminals
+        .into_iter()
+        .map(|identity| (identity.child_pid, identity.terminal_id))
+        .collect();
+    if by_pid.len() != manifest.panes.len() {
+        return Err(mismatch());
+    }
+    let mut seen = std::collections::HashSet::new();
+    // Validate the entire mapping before assigning any identity.
+    for pane in &manifest.panes {
+        let Some(identity) = by_pid.get(&pane.child_pid) else {
+            return Err(mismatch());
+        };
+        if !seen.insert(identity.clone())
+            || !identity.as_str().starts_with("term_")
+            || identity.as_str().len() > 128
+            || !identity.as_str()[5..]
+                .bytes()
+                .all(|byte| byte.is_ascii_hexdigit())
+            || identity.as_str().len() == 5
+            || pane
+                .terminal_id
+                .as_ref()
+                .is_some_and(|original| original != identity)
+        {
+            return Err(mismatch());
+        }
+    }
+    for pane in &mut manifest.panes {
+        pane.terminal_id = by_pid.get(&pane.child_pid).cloned();
+    }
+    Ok(())
+}
