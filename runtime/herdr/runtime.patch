+        let runtime = TerminalRuntime::test_with_scrollback_bytes(
+            80,
+            3,
+            32768,
+            b"first\r\nsecond\r\nthird\r\nfourth",
+        );
+        let observer = runtime.observe("terminal-test".into(), "boot-test".into());
+        let before = observer.snapshot().unwrap().unwrap();
+        runtime.test_process_pty_bytes(b"\r\nfifth");
+        let old_history = observer
+            .history(
+                "boot-test",
+                before.revision,
+                Some(before.history_epoch),
+                0,
+                1,
+            )
+            .unwrap();
+        assert!(text(&old_history).contains("first"));
+        let mut after = observer.snapshot().unwrap().unwrap();
+        let mut last_index = 0;
+        for index in 0..20_000 {
+            runtime.test_process_pty_bytes(format!("\r\n{index:06} {}", "x".repeat(60)).as_bytes());
+            after = observer.snapshot().unwrap().unwrap();
+            assert_eq!(after.history_epoch, before.history_epoch);
+            last_index = index;
+            if after.row_offset > 0 {
+                break;
+            }
+        }
+        assert!(
+            after.row_offset > 0,
+            "small scrollback must prune old pages: total={}, epoch={}",
+            after.total_rows,
+            after.history_epoch
+        );
+        let logical_first = after.row_offset + after.first_row;
+        let history = observer
+            .history(
+                "boot-test",
+                before.revision,
+                Some(before.history_epoch),
+                logical_first - 1,
+                1,
+            )
+            .unwrap();
+        assert!(text(&history).contains(&format!("{:06}", last_index - 3)));
+        assert!(observer
+            .history(
+                "boot-test",
+                before.revision,
+                Some(before.history_epoch),
+                0,
+                1
+            )
+            .is_err());
+        runtime.resize(3, 40, 0, 0);
+        assert_ne!(
+            observer.snapshot().unwrap().unwrap().history_epoch,
+            before.history_epoch
+        );
+        assert!(observer
+            .history(
+                "boot-test",
+                before.revision,
+                Some(before.history_epoch),
+                logical_first - 1,
+                1
+            )
+            .is_err());
+    }
