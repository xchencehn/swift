+#[test]
+fn direct_semantic_keys_follow_native_modes_and_cannot_escape_the_bound_terminal() {
+    with_terminal_session_test_server(|server, runtime_id, terminal_id, pane_id| {
+        let (runtime, mut input) =
+            crate::terminal::TerminalRuntime::test_with_channel_and_scrollback_bytes(
+                80,
+                24,
+                0,
+                b"\x1b[?1h",
+                16,
+            );
+        server
+            .app
+            .terminal_runtimes
+            .insert(runtime_id.clone(), runtime);
+        connect_pending_terminal_client(server, 1);
+        let key = || {
+            protocol::ClientPaneInputEvent::from_terminal_key(crate::input::TerminalKey::new(
+                crossterm::event::KeyCode::Up,
+                crossterm::event::KeyModifiers::NONE,
+            ))
+            .unwrap()
+        };
+        let event = |target: String| ServerEvent::ClientShellPaneInput {
+            client_id: 1,
+            pane_id: target,
+            events: vec![key()],
+        };
+        assert!(!server.handle_server_event(event(pane_id.clone())));
+        assert!(
+            input.try_recv().is_err(),
+            "unbound connection must not accept keys"
+        );
+        server.clients.get_mut(&1).unwrap().mode = ClientConnectionMode::TerminalAttach {
+            terminal_id: terminal_id.clone(),
+        };
+        assert!(!server.handle_server_event(event("unrelated:p1".into())));
+        assert!(input.try_recv().is_err());
+        assert!(server.handle_server_event(event(pane_id.clone())));
+        assert_eq!(input.try_recv().unwrap(), Bytes::from_static(b"\x1bOA"));
+        server
+            .app
+            .terminal_runtimes
+            .get(&runtime_id)
+            .unwrap()
+            .test_process_pty_bytes(b"\x1b[?1l");
+        assert!(server.handle_server_event(event(pane_id)));
+        assert_eq!(input.try_recv().unwrap(), Bytes::from_static(b"\x1b[A"));
+        assert_eq!(
+            server
+                .runtime_for_terminal_id_string(&terminal_id)
+                .unwrap()
+                .current_size(),
+            (24, 80)
+        );
+        server.remove_client(1);
+        assert!(
+            input.try_recv().is_err(),
+            "legacy key releases produce no raw bytes"
+        );
+    });
+}
