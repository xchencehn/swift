+    /// Read an absolute screen/history row without moving the shared viewport.
+    pub fn screen_styled_row(&self, row: u32) -> Result<StyledScreenRow, Error> {
+        // Resolve live rows through ACTIVE coordinates: SCREEN lookups traverse
+        // the scrollback page list and would make every frame scale with history.
+        let history = self.total_rows()?.saturating_sub(usize::from(self.rows()?));
+        let point = if row as usize >= history {
+            ffi::GhosttyPoint {
+                tag: ffi::GhosttyPointTag_GHOSTTY_POINT_TAG_ACTIVE,
+                value: ffi::GhosttyPointValue {
+                    coordinate: ffi::GhosttyPointCoordinate {
+                        x: 0,
+                        y: row - history as u32,
+                    },
+                },
+            }
+        } else {
+            ghostty_screen_point(0, row)
+        };
+        let mut grid_ref = self.grid_ref(point)?;
+        let (soft_wrapped, wrap_continuation) = grid_ref_wrap_state(&grid_ref)?;
+        let mut cells = Vec::with_capacity(usize::from(self.cols()?));
+        for x in 0..self.cols()? {
+            grid_ref.x = x;
+            let mut style = ffi::GhosttyStyle {
+                size: mem::size_of::<ffi::GhosttyStyle>(),
+                ..Default::default()
+            };
+            // SAFETY: the row reference and output style live through this call.
+            unsafe {
+                ffi::ghostty_grid_ref_style(&grid_ref, &mut style).into_result()?;
+            }
+            let mut raw = ffi::GhosttyCell::default();
+            // SAFETY: grid_ref still refers to the same locked terminal row.
+            unsafe {
+                ffi::ghostty_grid_ref_cell(&grid_ref, &mut raw).into_result()?;
+            }
+            let mut style: CellStyle = style.into();
+            // Erased cells store their background in the content tag rather
+            // than the style table. Preserve palette indices for client themes.
+            if let Some(background) = cell_content_bg_color(raw)? {
