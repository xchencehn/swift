+//! Runtime terminal observations. Reading never moves the terminal viewport or
+//! acquires geometry control. Slow clients retain only their last sent state.
+use std::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Arc, Condvar, Mutex, Weak};
+use std::time::Duration;
+
+use crate::pane::PaneTerminal;
+use serde::Serialize;
+
+#[derive(Default)]
+pub(crate) struct ObservationSignal {
+    generation: AtomicU64,
+    watchers: AtomicUsize,
+    closed: AtomicBool,
+    lock: Mutex<()>,
+    changed: Condvar,
+    cache: Mutex<Option<Arc<TerminalSnapshot>>>,
+}
+
+impl ObservationSignal {
+    pub(crate) fn changed(&self) {
+        if self.watchers.load(Ordering::Relaxed) == 0 {
+            return;
+        }
+        let Ok(_guard) = self.lock.lock() else {
+            return;
+        };
+        self.generation.fetch_add(1, Ordering::Release);
+        self.changed.notify_all();
+    }
+
+    pub(crate) fn close(&self) {
+        self.closed.store(true, Ordering::Release);
+        self.changed();
+    }
+}
+
+// Colour: -1 = default, 0..255 = palette, 0x1000000 | rgb = true colour.
+// Cell: text, width (0=wide tail, 3=wrap spacer), fg, bg, attributes,
+// underline colour, hyperlink. Underline style occupies attribute bits 8..10.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub(crate) struct TerminalCell(
+    pub String,
+    pub u8,
+    pub i32,
+    pub i32,
+    pub u16,
+    pub i32,
+    pub Option<String>,
+);
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub(crate) struct TerminalRow {
+    pub cells: Vec<TerminalCell>,
+    pub soft_wrapped: bool,
+    pub wrap_continuation: bool,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub(crate) struct TerminalSnapshot {
+    pub revision: u64,
+    pub cols: u16,
+    pub rows: u16,
+    pub total_rows: usize,
+    pub first_row: usize,
+    pub row_offset: usize,
+    pub history_epoch: u64,
+    pub history_start: usize,
+    pub history: Vec<TerminalRow>,
+    pub cursor: (u16, u16, bool),
+    pub cursor_shape: u8,
+    pub alternate_screen: bool,
+    pub mouse_tracking: bool,
+    pub mouse_sgr: bool,
+    pub mouse_pixels: bool,
+    pub bracketed_paste: bool,
+    pub content: Vec<TerminalRow>,
+}
+
+pub(crate) struct TerminalObserver {
+    pub terminal_id: String,
+    pub boot_id: String,
+    terminal: Weak<PaneTerminal>,
+    content_lock: Arc<Mutex<()>>,
+    revision: Arc<AtomicU64>,
+    signal: Arc<ObservationSignal>,
+}
+
+impl Drop for TerminalObserver {
+    fn drop(&mut self) {
+        if self.signal.watchers.fetch_sub(1, Ordering::Relaxed) == 1 {
+            if let Ok(mut cache) = self.signal.cache.lock() {
+                *cache = None;
+            }
+        }
+    }
+}
+
+fn color(value: Option<crate::ghostty::CellColor>) -> i32 {
+    match value {
+        None => -1,
+        Some(crate::ghostty::CellColor::Palette(index)) => i32::from(index),
+        Some(crate::ghostty::CellColor::Rgb(rgb)) => {
+            0x1000000 | (i32::from(rgb.r) << 16) | (i32::from(rgb.g) << 8) | i32::from(rgb.b)
+        }
+    }
+}
+
+fn row(source: crate::ghostty::StyledScreenRow) -> TerminalRow {
+    TerminalRow {
+        soft_wrapped: source.soft_wrapped,
+        wrap_continuation: source.wrap_continuation,
+        cells: source
+            .cells
+            .into_iter()
+            .map(|cell| {
+                let s = cell.style;
+                let attributes = u16::from(s.bold)
+                    | (u16::from(s.italic) << 1)
+                    | (u16::from(s.faint) << 2)
+                    | (u16::from(s.blink) << 3)
+                    | (u16::from(s.inverse) << 4)
+                    | (u16::from(s.invisible) << 5)
+                    | (u16::from(s.strikethrough) << 6)
+                    | (u16::from(s.overline) << 7)
+                    | (u16::from(s.underline) << 8);
+                TerminalCell(
+                    cell.graphemes
+                        .into_iter()
+                        .filter_map(char::from_u32)
+                        .collect(),
+                    match cell.wide {
+                        crate::ghostty::CellWide::Narrow => 1,
+                        crate::ghostty::CellWide::Wide => 2,
+                        crate::ghostty::CellWide::SpacerTail => 0,
+                        crate::ghostty::CellWide::SpacerHead => 3,
+                    },
+                    color(s.fg_color),
+                    color(s.bg_color),
+                    attributes,
+                    color(s.underline_color),
+                    cell.hyperlink,
+                )
+            })
+            .collect(),
+    }
+}
+
+impl TerminalObserver {
+    pub(crate) fn new(
+        terminal_id: String,
+        boot_id: String,
+        terminal: Weak<PaneTerminal>,
+        content_lock: Arc<Mutex<()>>,
+        revision: Arc<AtomicU64>,
+        signal: Arc<ObservationSignal>,
+    ) -> Self {
+        signal.watchers.fetch_add(1, Ordering::Relaxed);
+        Self {
+            terminal_id,
+            boot_id,
+            terminal,
+            content_lock,
+            revision,
+            signal,
+        }
+    }
+
+    pub(crate) fn generation(&self) -> u64 {
+        self.signal.generation.load(Ordering::Acquire)
+    }
+    pub(crate) fn closed(&self) -> bool {
+        self.signal.closed.load(Ordering::Acquire)
+    }
+
+    pub(crate) fn wait(&self, generation: u64, timeout: Duration) {
+        if let Ok(guard) = self.signal.lock.lock() {
+            let _ = self.signal.changed.wait_timeout_while(guard, timeout, |_| {
+                self.generation() == generation && !self.closed()
+            });
+        }
+    }
+
+    pub(crate) fn snapshot(&self) -> Result<Option<Arc<TerminalSnapshot>>, String> {
+        let terminal = self.terminal.upgrade().ok_or("terminal closed")?;
+        let _content = self
+            .content_lock
+            .lock()
+            .map_err(|_| "terminal unavailable")?;
+        let revision = self.revision.load(Ordering::Acquire);
+        let mut cache = self
+            .signal
+            .cache
+            .lock()
+            .map_err(|_| "terminal unavailable")?;
+        if let Some(snapshot) = cache
+            .as_ref()
+            .filter(|snapshot| snapshot.revision == revision)
+        {
+            return Ok(Some(snapshot.clone()));
+        }
+        let mut core = terminal
+            .ghostty
+            .core
+            .lock()
+            .map_err(|_| "terminal unavailable")?;
+        let t = &mut core.terminal;
+        let read = |error: crate::ghostty::Error| error.to_string();
+        if t.mode_get(crate::ghostty::MODE_SYNCHRONIZED_OUTPUT)
+            .map_err(read)?
+        {
+            return Ok(None);
+        }
+        let cols = t.cols().map_err(read)?;
+        let rows = t.rows().map_err(read)?;
+        let total_rows = t.total_rows().map_err(read)?;
+        if usize::from(cols) * usize::from(rows) > 262144 {
+            return Err("terminal dimensions exceed observation limit".into());
+        }
+        let first_row = total_rows.saturating_sub(usize::from(rows));
+        let content = (first_row..total_rows)
+            .map(|index| t.screen_styled_row(index as u32).map(row).map_err(read))
+            .collect::<Result<Vec<_>, _>>()?;
+        let coordinates = t.observation_history_coordinates().map_err(read)?;
+        let logical_first = first_row + coordinates.offset;
+        let previous_first = cache
+            .as_ref()
+            .filter(|old| old.history_epoch == coordinates.epoch)
+            .map(|old| old.first_row + old.row_offset);
+        let history_start = previous_first
+            .unwrap_or(logical_first.saturating_sub(200))
+            .max(coordinates.offset)
+            .max(logical_first.saturating_sub(256))
+            .min(logical_first);
+        let history = (history_start..logical_first)
+            .map(|index| {
+                t.screen_styled_row((index - coordinates.offset) as u32)
+                    .map(row)
+                    .map_err(read)
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        let snapshot = Arc::new(TerminalSnapshot {
+            revision,
+            cols,
+            rows,
+            total_rows,
+            first_row,
+            row_offset: coordinates.offset,
+            history_epoch: coordinates.epoch,
+            history_start,
+            history,
+            cursor: (
+                t.cursor_x().map_err(read)?,
+                t.cursor_y().map_err(read)?,
+                t.mode_get(25).map_err(read)?,
+            ),
+            cursor_shape: t.cursor_shape().map_err(read)?,
+            alternate_screen: t.active_screen().map_err(read)?
+                == crate::ghostty::ActiveScreen::Alternate,
+            mouse_tracking: t.mouse_tracking_enabled().map_err(read)?,
+            mouse_sgr: t.mode_get(1006).map_err(read)?,
+            mouse_pixels: t.mode_get(1016).map_err(read)?,
+            bracketed_paste: t.mode_get(2004).map_err(read)?,
+            content,
+        });
+        *cache = Some(snapshot.clone());
+        Ok(Some(snapshot))
+    }
+
+    pub(crate) fn history(
+        &self,
+        expected_boot: &str,
+        expected_revision: u64,
+        expected_epoch: Option<u64>,
+        start: usize,
+        limit: usize,
+    ) -> Result<Vec<TerminalRow>, String> {
+        if expected_boot != self.boot_id {
+            return Err("runtime identity changed".into());
+        }
+        let terminal = self.terminal.upgrade().ok_or("terminal closed")?;
+        let _content = self
+            .content_lock
+            .lock()
+            .map_err(|_| "terminal unavailable")?;
+        if expected_epoch.is_none() && expected_revision != self.revision.load(Ordering::Acquire) {
+            return Err("terminal revision changed".into());
+        }
+        let mut core = terminal
+            .ghostty
+            .core
+            .lock()
+            .map_err(|_| "terminal unavailable")?;
+        let t = &mut core.terminal;
+        let total = t.total_rows().map_err(|e| e.to_string())?;
+        let cols = usize::from(t.cols().map_err(|e| e.to_string())?).max(1);
+        if limit > 2048 || limit.saturating_mul(cols) > 262144 {
+            return Err("history range exceeds limit".into());
+        }
+        let coordinates = t
+            .observation_history_coordinates()
+            .map_err(|e| e.to_string())?;
+        let (offset, end) = if let Some(epoch) = expected_epoch {
+            if epoch != coordinates.epoch || start < coordinates.offset {
+                return Err("history epoch changed or rows were pruned".into());
+            }
+            (
+                coordinates.offset,
+                total.saturating_sub(usize::from(t.rows().map_err(|e| e.to_string())?)),
+            )
+        } else {
+            (0, total)
+        };
+        let start = start.saturating_sub(offset);
+        (start.min(end)..start.saturating_add(limit).min(end))
+            .map(|index| {
+                t.screen_styled_row(index as u32)
+                    .map(row)
+                    .map_err(|e| e.to_string())
+            })
+            .collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::terminal::TerminalRuntime;
+
+    fn text(rows: &[TerminalRow]) -> String {
+        rows.iter()
+            .map(|row| {
+                row.cells
+                    .iter()
+                    .map(|cell| cell.0.as_str())
+                    .collect::<String>()
+            })
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+
+    #[tokio::test]
+    async fn observation_is_independent_of_native_viewport_and_preserves_styled_history() {
+        let runtime = TerminalRuntime::test_with_scrollback_bytes(
+            20,
+            3,
+            1024 * 1024,
+            "\x1b[31m红色\x1b[0m\r\nsecond\r\nthird\r\nfourth\r\nfifth".as_bytes(),
+        );
+        runtime.scroll_up(2);
+        let metrics = runtime.scroll_metrics();
+        let observer = runtime.observe("terminal-test".into(), "boot-test".into());
+        let snapshot = observer.snapshot().unwrap().unwrap();
+        assert!(text(&snapshot.content).contains("fifth"));
+        let history = observer
+            .history("boot-test", snapshot.revision, None, 0, snapshot.first_row)
+            .unwrap();
+        assert!(text(&history).contains("红色"));
+        assert_eq!(history[0].cells[0].1, 2);
+        assert_eq!(history[0].cells[0].2, 1);
+        assert_eq!(history[0].cells[1].1, 0);
+        assert_eq!(metrics, runtime.scroll_metrics());
+        assert_eq!(runtime.terminal_dimensions(), Some((20, 3)));
+    }
+
+    #[tokio::test]
+    async fn observation_preserves_erased_backgrounds_in_live_rows_and_history() {
+        let runtime = TerminalRuntime::test_with_scrollback_bytes(
+            20,
+            4,
+            1024 * 1024,
+            b"\x1b[48;5;8m\x1b[2K> user message\x1b[0m\r\n\x1b[48;2;12;34;56m\x1b[20Xrgb\x1b[0m\r\n\x1b[48;5;8m\x1b[2K\x1b[0m",
+        );
+        let observer = runtime.observe("terminal-test".into(), "boot-test".into());
+        let snapshot = observer.snapshot().unwrap().unwrap();
+        for (y, background) in [(0, 8), (1, 0x10c2238), (2, 8), (3, -1)] {
+            assert!(
+                snapshot.content[y]
+                    .cells
+                    .iter()
+                    .all(|cell| cell.3 == background),
+                "row {y} must retain its background, including cells without text"
+            );
+        }
+
+        runtime.test_process_pty_bytes(b"\x1b[H\x1b[2K");
+        let cleared = observer.snapshot().unwrap().unwrap();
+        assert!(cleared.content[0].cells.iter().all(|cell| cell.3 == -1));
+        assert!(cleared.content[1]
+            .cells
+            .iter()
+            .all(|cell| cell.3 == 0x10c2238));
+
+        runtime.test_process_pty_bytes(b"\x1b[4;1H\r\n\r\n");
+        let scrolled = observer.snapshot().unwrap().unwrap();
+        let history = observer
+            .history("boot-test", scrolled.revision, None, 0, scrolled.first_row)
+            .unwrap();
+        assert!(history[1].cells.iter().all(|cell| cell.3 == 0x10c2238));
+    }
+
+    #[tokio::test]
+    async fn observers_share_atomic_snapshots_and_reject_stale_history() {
+        let runtime = TerminalRuntime::test_with_screen_bytes(20, 3, b"before");
+        let first = runtime.observe("terminal-test".into(), "boot-test".into());
+        let second = runtime.observe("terminal-test".into(), "boot-test".into());
+        let before = first.snapshot().unwrap().unwrap();
+        assert!(Arc::ptr_eq(&before, &second.snapshot().unwrap().unwrap()));
+        let generation = first.generation();
+        runtime.test_process_pty_bytes(b"\r\x1b[2Kafter\x1b[?1000h\x1b[?1006h\x1b[?2004h");
+        assert!(first.generation() > generation);
+        let after = first.snapshot().unwrap().unwrap();
+        assert!(after.revision > before.revision);
+        assert!(text(&after.content).contains("after"));
+        assert!(after.mouse_tracking && after.mouse_sgr && after.bracketed_paste);
+        assert!(first
+            .history("boot-test", before.revision, None, 0, 1)
+            .is_err());
+        assert!(first
+            .history("other-boot", after.revision, None, 0, 1)
+            .is_err());
+        drop(runtime);
+        assert!(first.closed() && second.closed());
+    }
+
