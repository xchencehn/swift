+#[cfg(unix)]
+#[derive(Deserialize)]
+struct TerminalIdentityMap {
+    version: u32,
+    source_version: String,
+    source_protocol: u32,
+    source_pid: u32,
+    source_socket: PathBuf,
+    terminals: Vec<TerminalIdentity>,
