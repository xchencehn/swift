+                graphemes: grid_ref_graphemes(&grid_ref)?,
+                style,
+                hyperlink: grid_ref_hyperlink_uri(&grid_ref)?,
+            });
+        }
+        Ok(StyledScreenRow {
+            cells,
+            soft_wrapped,
+            wrap_continuation,
+        })
+    }
