# Open-source direct execution endpoint. Never commit a real token here.
HOST=0.0.0.0
PORT=8792
SWIFT_BASE_PATH=/swift
SWIFT_DIRECT_AUTH=local
SWIFT_ROOT_DIR=/absolute/project
# SWIFT_WSL_HOST is detected at installation for local Windows/WSL trust.
# Force token auth when using an external SSH tunnel:
# SWIFT_DIRECT_AUTH=token
# SWIFT_PUBLIC_URL=http://127.0.0.1:18792/swift/
