{
  "name": "swift",
  "version": "0.20.4",
  "private": true,
  "license": "Apache-2.0",
  "description": "Swift: direct server and clients for native Agent sessions",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "start:execution": "node server.js",
    "check": "node scripts/check/check.js",
    "test": "node scripts/check/run-tests.js",
    "smoke": "node scripts/testing/protocol-smoke.js",
    "harness:frontend": "node scripts/testing/frontend-harness.js",
    "harness:settings": "node scripts/testing/settings-harness.js",
    "harness:settings-layout": "node scripts/testing/settings-layout-harness.js",
    "harness:settings-save": "node scripts/testing/settings-save-harness.js",
    "harness:chat": "node scripts/testing/chat-harness.js --run",
    "harness:mermaid": "node scripts/testing/mermaid-harness.js",
    "smoke:history:claude": "CLAUDE_TUI_PROBE=1 node scripts/testing/native-claude-history-smoke.js",
    "generate:types": "node scripts/build/generate-protocol-types.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "release": "node scripts/release/package-release.js",
    "validate": "node scripts/check/validate.js",
    "generate:providers": "node scripts/build/generate-provider-capabilities.mjs",
    "generate:shared": "node scripts/build/generate-provider-capabilities.mjs",
    "harness:recovery": "node scripts/testing/local-recovery-harness.js",
    "benchmark:storage": "node scripts/testing/storage-benchmark.js",
    "smoke:install": "node scripts/testing/release-install-smoke.js",
    "harness:providers": "node scripts/testing/provider-sync-harness.js",
    "smoke:token:java": "node scripts/testing/token-java-smoke.js",
    "harness:token": "node scripts/testing/token-browser-harness.js",
    "desktop:prepare": "node scripts/build/build-desktop.js",
    "desktop:test": "npm run desktop:prepare && cargo test --manifest-path desktop/Cargo.toml",
    "desktop:build": "node scripts/build/build-windows-desktop.js",
    "harness:desktop": "npm run desktop:prepare && cargo build --manifest-path desktop/Cargo.toml --bin desktop-fixture && node scripts/testing/desktop-harness.js",
    "harness:desktop:windows": "node scripts/testing/windows-desktop-harness.js",
    "release:desktop": "node scripts/release/package-desktop.js",
    "harness:structured": "node scripts/testing/structured-harness.js",
    "generate:terminal": "node scripts/build/terminal-assets.js",
    "harness:downloads": "node scripts/testing/output-download-harness.js",
    "harness:shell": "node scripts/testing/shell-terminal-harness.js",
    "harness:questions": "node scripts/testing/codex-question-harness.js",
    "smoke:questions:native": "node scripts/testing/codex-question-native-harness.js",
    "harness:terminal-preview": "node scripts/testing/agent-terminal-harness.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:repository": "node scripts/check/repository.js",
    "harness:network": "npm run harness:desktop",
    "harness:renderers": "node scripts/testing/renderer-recovery-harness.js",
    "release:source": "node scripts/release/package-source.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "^1.1.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "22.10.2",
    "@types/ws": "8.5.13",
    "esbuild": "0.28.2",
    "typescript": "5.7.2",
    "prettier": "3.9.10",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5"
  },
  "bin": {
    "swift": "deploy/swift.sh"
  }
}
