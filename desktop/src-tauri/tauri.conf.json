{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swift",
  "version": "0.23.4",
  "identifier": "io.agentstudio.swift.desktop",
  "build": {
    "beforeBuildCommand": "node ../scripts/build/build-desktop.js",
    "beforeDevCommand": "node ../scripts/build/build-desktop.js",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Swift 会话与终端客户端",
    "category": "DeveloperTool",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "zlib"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3REIwQkFCRkQxODVDRDEKUldUUlhCajlxd3ZiaDhpL1pFR0wrT2hIZFFEMDQ0VldZWW5pOHNJSjNzY2toOXJIS3BRYWlxYXgK",
      "endpoints": ["https://150.158.39.216:8002/desktop/latest.json"],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
